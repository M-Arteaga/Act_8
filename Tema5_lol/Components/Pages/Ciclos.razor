    @while (_indice < _valorCiclo)
    {
        <li>Valor del cliclo: @_indice</li>
        _indice++;
    }
</ul> *@

@* renderizar contenido *@
@((MarkupString)_letrero)

@code {
    private int _valorCiclo, _indice;
    private bool _mostrar = false;
    private string _letrero = "<ul class='mt-3'></ul>";
    private List<int> _calificaciones = new();

    private void Guardar()
    {
        // _calificaciones.Add(_valorCiclo);
        // siempre lo agregua al inicio
        _calificaciones.Insert(0, _valorCiclo);
    }

    private void Eliminar()
    {
        _calificaciones.Remove(_valorCiclo);
    }

    private void Existe()
    {
        _mostrar = _calificaciones.Contains(_valorCiclo);
        _indice = _calificaciones.IndexOf(_valorCiclo);
    }

    private void Limpiar()
    {
        _calificaciones.Clear();
    }

    private void Saludar()
    { 
        // _indice = 0;
        // _letrero = "<ul class='mt-3'>";
        // while (_indice < _valorCiclo) {
        //     _letrero += $"<li>Valor del cliclo: {_indice}</li>";
        //     _indice++;
        // }
        // _letrero += "</ul>";

        // do
        // {
        //     _letrero += $"<li>Valor del cliclo: {_indice}</li>";
        //     _indice++;
        // } while (_indice < _valorCiclo);

        // _letrero += "</ul>";

        // var indice sólo tiene tiempo de vida dentro del cliclo for, la d _indice no se usa en este ciclo

        _letrero = "<ul class='mt-3'>";
        for (var indice = 0; indice < _valorCiclo; indice++)
        {
            if (indice == 5) // no se ejecutará cuando valor sea 5
            {
                continue; // para saltar la iteración actual, no se ejecuta el código debajo de esta línea y se pasa a la siguiente iteración
            }
            _letrero += $"<li>Valor del cliclo: {indice}</li>";

        }
        _letrero += "</ul>";
    }

    
}
