@page "/Ciclos"
@rendermode InteractiveServer

<h3>Ciclos</h3>
<div class="container">
    <div class="row mt-3 align-items-center">
        <div class="col-2">
            <label for="txtCalificacion" class="col-form-label">Calificacion:</label>
        </div>
        <div class="col-10">
            <input type="number" id="txtCalificacion" class="form-control" @bind="_valorCiclo" />
        </div>
    </div>
</div>

<button class="btn btn-primary mt-3" @onclick="Guardar">Guardar</button> 
<button class="btn btn-primary mt-3" @onclick="Eliminar">Eliminar</button>
<button class="btn btn-primary mt-3" @onclick="Existe">Existe</button>
<button class="btn btn-primary mt-3" @onclick="Limpiar">Limpiar</button>

<hr />
Calificaciones guardadas:@_calificaciones.Count 
<br />

@* recorre toda la colección, leyéndolos y comparando con su valor *@
Calificaciones guardadas con 9:@_calificaciones.Count(r => r == 9) <br />
<br />

Encontrado en: @_indice

@_mostrar

@if (_calificaciones.Count > 0) {
    <ul class="mt-3">
    @* @for(var indice=0; indice <_calificaciones.Count; indice++)
    {
        <li>@_calificaciones[indice]</li>
    }
    </ul> *@

    @* @foreach (var calificacion in _calificaciones)
    {
        <li>@calificacion</li>
    } *@

    @* calif aprobatorias *@
    @* @foreach (var calificacion in _calificaciones.Where(c => c > 5))
    {
        <li>@calificacion</li>
        }
    </ul> *@

    @* generar nueva colección de datos con esa restricción *@
    @foreach (var calificacion in _calificaciones.OrderBy(c => c))
    {
       <li>@calificacion</li>
    }
    </ul>

    <ul>
        @foreach (var calificacion in _calificaciones.Skip(2).Take(2))
        {
            <li>@calificacion</li>
        }
    </ul>
}

<hr />

