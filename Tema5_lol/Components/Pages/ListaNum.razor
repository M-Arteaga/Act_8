@page "/ListaNum"
@rendermode InteractiveServer

<h3>Lista de Números</h3>

<div class="container">
    <div class="row">
        <div class="col-2">
            <label for="txtNum1">Número 1:</label>
        </div>
        <div class="col-10 mb-3">
            <input type="number" id="txtNum1" class="form-control" @bind="_num1" />
        </div>
            
        <div class="col-2">
            <label for="txtNum2">Número 2:</label>
        </div>
        <div class="col-10">
            <input type="number" id="txtNum2" class="form-control" @bind="_num2" />
        </div>
    </div>

    <button class="btn btn-primary mb-3" @onclick="Calcular">Calcular</button>
</div>

@if (_pares.Count > 0 || _impares.Count > 0)
{
    <div class="container d-flex gap-4">
        <div class="flex-grow-1">
            <h2>Pares</h2>
            <table class="table table-striped">
                <tbody>
                    @foreach(var num in _pares)
                    {
                        <tr>
                            <td>@num</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="flex-grow-1">
            <h2>Impares</h2>
            <table class="table table-striped">
                <tbody>
                    @foreach (var num in _impares)
                    {
                        <tr>
                            <td>@num</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private int _num1;
    private int _num2;
    private List<int> _pares = new();
    private List<int> _impares = new();

    private void Calcular()
    {
        _pares.Clear();
        _impares.Clear();

        int menor = Math.Min(_num1, _num2);
        int mayor = Math.Max(_num1, _num2);

        for (var i = menor; i <= mayor; i++)
        {
            if (i % 2 == 0)
            {
                _pares.Add(i);
            }
            else
            {
                _impares.Add(i);
            }
        }

